# Caw Hub — environment template.
# Copy to .env and fill in. `.env` is git-ignored; never commit real secrets.

# ----------------------------------------------------------------------------
# Hub
# ----------------------------------------------------------------------------
# Shared secret used to verify GitHub's X-Hub-Signature-256 on incoming
# webhooks. Set the SAME value in your GitHub App's webhook config.
CAW_GH_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# OpenObserve (bundled default OTLP sink — ADR-0008)
# ----------------------------------------------------------------------------
# Root user created on first boot. Change the password before exposing the UI.
ZO_ROOT_USER_EMAIL=admin@example.com
ZO_ROOT_USER_PASSWORD=ChangeMe123!

# ----------------------------------------------------------------------------
# OpenTelemetry export (Hub -> OTLP backend)
# ----------------------------------------------------------------------------
# Where the Hub ships traces/logs/metrics. For the bundled OpenObserve this is
# its OTLP gRPC endpoint, already wired in docker-compose.yml as:
#     OTEL_EXPORTER_OTLP_ENDPOINT=http://openobserve:5081
#
# To use an EXTERNAL backend (your own OpenObserve, Grafana/Tempo, Datadog, ...)
# override OTEL_EXPORTER_OTLP_ENDPOINT in docker-compose.yml (or your env) with
# that backend's OTLP endpoint.
#
# To DISABLE telemetry export entirely: leave the endpoint UNSET (remove the
# OTEL_EXPORTER_OTLP_ENDPOINT line). The Hub then emits nothing (ADR-0008).
#
# OpenObserve authenticates OTLP with HTTP Basic auth plus org/stream routing
# headers. Build the value below and set it as OTEL_EXPORTER_OTLP_HEADERS.
#
#   Authorization: Basic <base64(email:password)>
#   organization:  <org id, default "default">
#   stream-name:   <stream, e.g. "default">
#
# Generate the Basic token (use the same email/password as above):
#   printf '%s' 'admin@example.com:ChangeMe123!' | base64
#
# Then set the full header string (comma-separated key=value pairs):
#   OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <token>,organization=default,stream-name=default
#
# Example (placeholder token — replace with your own base64):
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic YWRtaW5AZXhhbXBsZS5jb206Q2hhbmdlTWUxMjMh,organization=default,stream-name=default

# ----------------------------------------------------------------------------
# GitHub App identity (Slice 5)
# ----------------------------------------------------------------------------
# GitHub App numeric ID (shown on the App settings page).
CAW_APP_ID=

# Path to the RSA private key PEM file downloaded from the App settings page.
# Mutually exclusive with CAW_APP_PRIVATE_KEY_PEM.
CAW_APP_PRIVATE_KEY_PATH=

# Alternatively, embed the PEM inline (useful for container environments).
# Set EITHER this OR CAW_APP_PRIVATE_KEY_PATH — not both.
CAW_APP_PRIVATE_KEY_PEM=

# OAuth client credentials (found on the App settings page).
CAW_APP_CLIENT_ID=
CAW_APP_CLIENT_SECRET=

# Publicly reachable base URL of this Hub instance, e.g. https://caw.example.com
# Required for the self-host manifest flow (GET /github/app/manifest).
CAW_BASE_URL=
