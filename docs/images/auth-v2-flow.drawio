      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Caw Auth v2 — MCP login + auto-subscribe-on-PR-open" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2320" height="40" as="geometry" />
        </mxCell>

        <!-- LIFELINE HEADERS -->
        <mxCell id="hAgent" value="Coding Agent&#xa;(Claude Code / Cursor / Codex)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="80" y="80" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hMCP" value="caw-watcher (MCP)&#xa;running locally" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="400" y="80" width="240" height="60" as="geometry" />
