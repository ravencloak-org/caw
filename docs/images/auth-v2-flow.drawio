        <mxCell id="hBrowser" value="User's Browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="720" y="80" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hHub" value="caw Hub&#xa;caw.ravencloak.org" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1040" y="80" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hGitHub" value="GitHub&#xa;OAuth + REST + Webhooks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1360" y="80" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hRepoMaint" value="Repo Maintainer&#xa;(or CI bot)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1680" y="80" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hSqlite" value="caw.db (SQLite)&#xa;tokens, auth_sessions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2000" y="80" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- DASHED LIFELINE LINES (no source/target, just coordinates) -->
        <mxCell id="llAgent" style="endArrow=none;html=1;dashed=1;strokeColor=#6c8ebf;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="200" y="140" as="sourcePoint" />
